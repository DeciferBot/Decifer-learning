// ---------- Decifer Live (Kahoot-style multiplayer) ----------
// PIN-gated, authenticated child profiles only. Display-names only, no chat,
// no public/global leaderboard (UK Children's Code §11). Server-authoritative:
// correctness is checked against quiz_questions.correct_answer (code-verified
// content, never an LLM — CLAUDE.md §4) and speed-points are computed from the
// server clock, never client-reported time. State propagates via Supabase
// Realtime (Postgres Changes) so all devices stay in sync.

enum LiveGameStatus {
  lobby
  in_progress
  finished
}

model LiveGame {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pin                  String         @unique // 6-digit join code, unique among active games
  host_profile_id      String?        @db.Uuid // null for guest hosts
  host_email           String? // required when host_profile_id is null
  host_guest_token     String?        @db.Uuid // cookie token for guest-host auth
  status               LiveGameStatus @default(lobby)
  // Content scope: a single topic, or a mixed pool across a subject + year group.
  mode                 String         @default("topic") // 'topic' | 'subject'
  topic_id             String?        @db.Uuid
  subject_id           String?        @db.Uuid
  year_group_id        String?        @db.Uuid
  question_ids         Json // ordered array of PUBLISHED quiz_question IDs
  question_count       Int            @default(10)
  seconds_per_question Int            @default(20)
  current_index        Int            @default(-1) // -1 = lobby; 0..n-1 active; >= n finished
  current_started_at   DateTime? // server timestamp the current question went live
  created_at           DateTime       @default(now())
  finished_at          DateTime?

  host    Profile?         @relation("HostedLiveGames", fields: [host_profile_id], references: [id], onDelete: Cascade)
  players LiveGamePlayer[]
  answers LiveGameAnswer[]

  @@index([status, created_at])
  @@index([host_guest_token])
  @@map("live_games")
}

model LiveGamePlayer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id       String   @db.Uuid
  // Null for guest players (joined with just a nickname, no account — Kahoot
  // style). Logged-in players carry their profile id.
  profile_id    String?  @db.Uuid
  // Per-browser token identifying a guest across requests (cookie-backed).
  guest_token   String?  @db.Uuid
  is_guest      Boolean  @default(false)
  display_name  String
  avatar_config Json?
  score         Int      @default(0)
  streak        Int      @default(0)
  is_host       Boolean  @default(false)
  joined_at     DateTime @default(now())
  last_seen     DateTime @default(now())

  game    LiveGame         @relation(fields: [game_id], references: [id], onDelete: Cascade)
  profile Profile?         @relation("LiveGamePlayers", fields: [profile_id], references: [id], onDelete: Cascade)
  answers LiveGameAnswer[]

  @@unique([game_id, profile_id]) // a profile joins a given game once
  @@unique([game_id, guest_token]) // a guest browser joins a given game once
  @@index([game_id, score(sort: Desc)])
  @@map("live_game_players")
}

model LiveGameAnswer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id        String   @db.Uuid
  player_id      String   @db.Uuid
  question_index Int
  question_id    String   @db.Uuid
  answer         String
  was_correct    Boolean
  ms_taken       Int
  points_awarded Int
  created_at     DateTime @default(now())

  game   LiveGame       @relation(fields: [game_id], references: [id], onDelete: Cascade)
  player LiveGamePlayer @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([player_id, question_index]) // one answer per player per question
  @@index([game_id, question_index])
  @@index([game_id, was_correct]) // end-game groupBy aggregation
  @@map("live_game_answers")
}

// Decifer Downtime — just-for-fun 2-player board games (Chess, Checkers,
// Connect 4, Scrabble), played with a friend via a 6-character invite code.
// No points, no curriculum content — see app/(child)/downtime. The host
// always plays the first side (White / Red / Red / first-to-place); the
// guest plays the second. Same guest-cookie identity pattern as Decifer
// Live (lib/downtime/server.ts mirrors lib/live/server.ts), but with its own
// cookie so the two features' guest identities don't couple.
//
// `state` is the PUBLIC board state — safe for both players and the anon
// Realtime broadcast to read, because Chess/Checkers/Connect 4 have no
// hidden information and Scrabble's public half (board tiles, scores, bag
// count) is likewise safe. `private_host_state` / `private_guest_state`
// exist only for Scrabble's rack — each player's rack must never be visible
// to the other, so those two columns are (like host_guest_token below)
// deliberately left out of the anon/authenticated column grant in the
// migration; only a server route reads a player's own rack out to them.
enum BoardGameType {
  chess
  checkers
  connect4
  scrabble
}

enum BoardGameStatus {
  waiting
  active
  finished
}

model BoardGame {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_type           BoardGameType
  invite_code         String          @unique
  status              BoardGameStatus @default(waiting)
  state               Json
  private_host_state  Json?
  private_guest_state Json?
  turn                String          @default("host") // 'host' | 'guest'
  winner              String? // 'host' | 'guest' | 'draw'
  host_profile_id     String?         @db.Uuid
  host_guest_token    String?         @db.Uuid
  host_display_name   String
  guest_profile_id    String?         @db.Uuid
  guest_guest_token   String?         @db.Uuid
  guest_display_name  String?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  finished_at         DateTime?

  host  Profile? @relation("HostedBoardGames", fields: [host_profile_id], references: [id], onDelete: Cascade)
  guest Profile? @relation("GuestBoardGames", fields: [guest_profile_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([host_guest_token])
  @@index([guest_guest_token])
  @@map("board_games")
}

// A finished Downtime game, one row per logged-in player — the game history
// behind "Your recent games" on /downtime. Guests have no rows here (nothing
// to attach them to); the game-over card instead invites them to register so
// future results are kept. Same server-only access posture as board_games:
// all reads and writes go through app code, never a client-side table query.
model DowntimeResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String   @db.Uuid
  game_type  String // catalogue id: chess | checkers | connect-4 | crossword | word-tiles
  mode       String // computer | friend | solo
  difficulty String? // easy | medium | hard — computer/solo games only
  outcome    String // win | loss | draw
  score      Int? // Word Tiles points; games without a score leave it null
  created_at DateTime @default(now())

  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, created_at])
  @@map("downtime_results")
}

// ---------- Decifer Skills Check ----------
// Free, no-login curriculum diagnostic. Scope: docs/SKILLS_CHECK_SCOPE.md
//
// Criterion-referenced, never norm-referenced: the check reports whether a child
// is secure on what the National Curriculum expects for their year. It never
// produces a standardised score, a percentile, or a comparison with another
// child. Scoring lives in lib/skills-check/score.ts (pure, unit-tested).
//
// Every table here is server-only: RLS on with no policies plus REVOKE ALL, same
// posture as board_games. The browser never reads them, which is what keeps
// skill_check_items (correct answers) and skill_check_leads (parent emails) shut.

enum SkillCheckFormat {
  // 20 items, 4 strands x 5, untimed.
  strand_sample
  // DfE Multiplication Tables Check shape: 25 items, 6 seconds each.
  timed_tables
}

/// Which year group an item was drawn from, RELATIVE to the check's own year.
enum SkillCheckBand {
  below
  at
  above
}

enum SkillCheckWorkingLevel {
  below_year
  towards_year
  within_year
  secure_year
  secure_ready_to_stretch
}

model SkillCheck {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// URL segment, e.g. 'maths-year-4'.
  slug             String           @unique
  subject_id       String           @db.Uuid
  year_group_id    String           @db.Uuid
  format           SkillCheckFormat @default(strand_sample)
  item_count       Int              @default(20)
  /// timed_tables only. The DfE check allows 6 seconds per question.
  seconds_per_item Int?
  /// Goes true only after every item has been hand-checked once (scope §11).
  is_published     Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now()) @updatedAt

  subject    Subject             @relation(fields: [subject_id], references: [id])
  year_group YearGroup           @relation(fields: [year_group_id], references: [id])
  items      SkillCheckItem[]
  attempts   SkillCheckAttempt[]
  answers    SkillCheckAnswer[]

  @@unique([subject_id, year_group_id, format])
  @@index([is_published])
  @@map("skill_checks")
}

model SkillCheckItem {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_id        String         @db.Uuid
  /// Points at a published quiz_questions row. Items carry no content of their own.
  question_id     String         @db.Uuid
  position        Int
  band            SkillCheckBand
  /// The AT-YEAR topic this item reports under. A 'below' item comes from last
  /// year's topic but reports under this year's strand, so the parent's report
  /// only ever names the year they asked about.
  strand_topic_id String         @db.Uuid
  created_at      DateTime       @default(now())

  check    SkillCheck         @relation(fields: [check_id], references: [id], onDelete: Cascade)
  question QuizQuestion       @relation(fields: [question_id], references: [id])
  strand   Topic              @relation("SkillCheckStrand", fields: [strand_topic_id], references: [id])
  answers  SkillCheckAnswer[]

  @@unique([check_id, position])
  @@unique([check_id, question_id])
  @@index([strand_topic_id])
  @@map("skill_check_items")
}

/// Anonymous by design. Holds NO personal data: no name, no date of birth, no
/// school. The token is the only handle, and it lives in a first-party cookie.
model SkillCheckAttempt {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_id       String                  @db.Uuid
  started_at     DateTime                @default(now())
  finished_at    DateTime?
  raw_score      Int?
  total_items    Int?
  working_level  SkillCheckWorkingLevel?
  /// Per-strand results as lib/skills-check/score.ts returns them. Denormalised
  /// so an old report still renders after a topic is renamed or an item retired.
  strand_results Json?
  /// Set only when a logged-in profile took it. Null for the public funnel.
  profile_id     String?                 @db.Uuid
  created_at     DateTime                @default(now())

  check   SkillCheck         @relation(fields: [check_id], references: [id])
  profile Profile?           @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  answers SkillCheckAnswer[]
  lead    SkillCheckLead?

  @@index([check_id, created_at])
  @@index([created_at])
  @@map("skill_check_attempts")
}

/// Kept to calibrate lib/irt.ts, which has never had data. Deliberately separate
/// from quiz_answers / session_answers: an anonymous check must never write into
/// a child's learning record.
///
/// SELF-CONTAINED ON PURPOSE. An answer carries its own question, check, band,
/// strand and position rather than reading them off `item`. Rebuilding a check
/// deletes and re-creates every skill_check_items row (see persistCheck), and an
/// answer that depended on the item row went with it. That is not hypothetical:
/// it silently threw away the first 20 answers the live check ever recorded
/// (2026-08-19). `item_id` is now nullable and SET NULL, so a rebuild loosens the
/// link and keeps the data.
///
/// `question_id` is the unit that matters anyway. Difficulty belongs to a
/// question, not to the slot a question happened to sit in, and lib/irt.ts
/// calibrates per question.
model SkillCheckAnswer {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id      String         @db.Uuid
  /// Null once the check has been rebuilt. Never the only route to the facts.
  item_id         String?        @db.Uuid
  /// The question actually asked. This is what IRT calibrates.
  question_id     String         @db.Uuid
  check_id        String         @db.Uuid
  band            SkillCheckBand
  /// The at-year topic this answer reports under, copied from the item.
  strand_topic_id String         @db.Uuid
  /// Position in the check as served, so a report can be reconstructed in order.
  position        Int
  child_answer    String?
  was_correct     Boolean
  time_seconds    Int?
  created_at      DateTime       @default(now())

  attempt  SkillCheckAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  item     SkillCheckItem?   @relation(fields: [item_id], references: [id], onDelete: SetNull)
  question QuizQuestion      @relation(fields: [question_id], references: [id], onDelete: Cascade)
  check    SkillCheck        @relation(fields: [check_id], references: [id], onDelete: Cascade)
  strand   Topic             @relation("SkillCheckAnswerStrand", fields: [strand_topic_id], references: [id])

  /// One answer per question per attempt. Replaces the old key on item_id, which
  /// stopped enforcing anything the moment item_id could be null.
  @@unique([attempt_id, question_id])
  @@index([question_id])
  @@index([check_id])
  @@map("skill_check_answers")
}

/// The parent's email, and nothing else.
model SkillCheckLead {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id       String    @unique @db.Uuid
  parent_email     String
  consented_at     DateTime  @default(now())
  verified_at      DateTime?
  /// Set by the one-click delete link in the report email. A tombstone, not a
  /// hard delete, so a deleted address is never re-emailed by a later cron.
  deleted_at       DateTime?
  /// Set when the six-week retest reminder goes out, so it goes out once.
  reminder_sent_at DateTime?
  source           String?
  utm              Json?
  created_at       DateTime  @default(now())

  attempt SkillCheckAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([parent_email])
  @@map("skill_check_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Decifer Reasoning Check — free, no-login non-verbal reasoning test.
// Scope: docs/REASONING_TEST_SCOPE.md
//
// AN ITEM IS A SEED, NOT A ROW. Every question is generated by
// lib/reasoning/generate.ts from (type, level, seed), deterministically, so
// there is no content table here at all. Marking regenerates the item on the
// server and compares, which means the correct answer never reaches a browser.
//
// Same server-only posture as the Skills Check: RLS on with no policies plus
// REVOKE ALL, and every read and write through app/api/reasoning/*.

enum ReasoningItemType {
  sequence
  matrix
  analogy
  odd_one_out
}

/// A band, deliberately coarse. NEVER a date of birth.
enum ReasoningAgeBand {
  year_3_4
  year_5_6
  year_7_8
  not_said
}

/// Anonymous by design. Holds NO personal data: no name, no date of birth, no
/// school. The token is the only handle, and it is also the seed the whole paper
/// is derived from.
model ReasoningAttempt {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored only so a like-for-like comparison becomes possible later (scope
  /// §9). It does not change the test — the adaptive ladder finds the level.
  age_band    ReasoningAgeBand  @default(not_said)
  started_at  DateTime          @default(now())
  finished_at DateTime?
  total_items Int?
  raw_score   Int?
  /// Highest level solved in at least two different item types. 0 means not
  /// enough evidence to name one. NEVER an IQ, percentile or standardised score.
  level_reached Int?
  /// Per-type results as lib/reasoning/score.ts returns them. Denormalised so an
  /// old report still renders after a generator changes.
  type_results  Json?
  /// Set only when a logged-in profile took it. Null for the public funnel.
  profile_id    String?         @db.Uuid
  created_at    DateTime        @default(now())

  profile Profile?          @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  answers ReasoningAnswer[]
  lead    ReasoningLead?

  @@index([created_at])
  @@index([age_band, finished_at])
  @@map("reasoning_attempts")
}

/// (item_type, level, seed) is the whole question. Storing those three rebuilds
/// a past paper exactly, with no content table and no stored answer key.
model ReasoningAnswer {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id   String            @db.Uuid
  position     Int
  item_type    ReasoningItemType
  level        Int
  seed         String
  /// Index into the option list the child saw. Null when they skipped it.
  chosen_index Int?
  was_correct  Boolean
  /// Milliseconds. Seconds are too coarse to compare one item type with another.
  time_ms      Int?
  created_at   DateTime          @default(now())

  attempt ReasoningAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, position])
  @@map("reasoning_answers")
}

/// The parent's email, and nothing else.
model ReasoningLead {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attempt_id   String    @unique @db.Uuid
  parent_email String
  consented_at DateTime  @default(now())
  verified_at  DateTime?
  /// Set by the one-click delete link in the report email. A tombstone, not a
  /// hard delete, so a deleted address is never re-emailed by a later cron.
  deleted_at   DateTime?
  source       String?
  utm          Json?
  created_at   DateTime  @default(now())

  attempt ReasoningAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([parent_email])
  @@map("reasoning_leads")
}

/// Oak National Academy lessons, fetched once each and kept forever.
///
/// Oak stops answering us after roughly a thousand fetches a day, and every earlier
/// importer spent that allowance re-reading lessons we already had. This table means
/// each lesson is fetched once, ever. Changing which questions we accept, or matching
/// a unit to a different topic, is then local work over this table with no fetching
/// at all.
///
/// No page reads this. Only the nightly jobs touch it, as the service role.
/// Content is Oak National Academy, Open Government Licence v3.0.
model OakLessonRaw {
  lesson_slug   String    @id
  unit_slug     String?
  key_stage     String?
  subject       String?
  oak_year_slug String?
  lesson_title  String?
  /// Oak's starter and exit quizzes, exactly as Oak returned them.
  quiz_json     Json?
  /// Oak's lesson summary. Its keywords make the first hint on a question.
  summary_json  Json?
  fetch_status  String?
  fetched_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([subject, oak_year_slug])
  @@index([unit_slug])
  @@index([fetch_status])
  @@map("oak_lessons_raw")
}
